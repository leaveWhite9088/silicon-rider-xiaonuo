# 运行产物
runs/*
!runs/README.md
out/
tests/_tmp/

# 种子明文：绝不入库（只提交 seeds.commit.json 里的承诺）
seeds.json
configs/seeds.json

# Python
__pycache__/
*.pyc
*.pyo

# 会话桥的运行时状态（守护进程/端口/日志）
.sessions/

# 日志与临时文件
*.log
*.tmp

# 盲评运行时产物：包和私有映射不进入仓库
leaderboard/blind/
leaderboard/verdicts/*.blind-map.json
leaderboard/verdicts/*.draft.json
